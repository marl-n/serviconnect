generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  BUSINESS
  ADMIN
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  UNVERIFIED
}

enum LeadStatus {
  NEW
  VIEWED
  QUOTED
  ACCEPTED
  REJECTED
  COMPLETED
}

enum ServiceRequestStatus {
  OPEN
  MATCHED
  EXPIRED
  CANCELLED
  FULFILLED
}

enum QuestionType {
  TEXT
  NUMBER
  SELECT
  MULTISELECT
  BOOLEAN
  DATE
}

enum CreditTransactionType {
  PURCHASE
  PROMOTIONAL
  LEAD_UNLOCK
  REFUND
  ADMIN_ADJUSTMENT
}

enum CreditPurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SubscriptionPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum AdStatus {
  ACTIVE
  PAUSED
  BUDGET_DEPLETED
}

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  email         String?   @unique
  name          String
  avatarUrl     String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business        Business?
  leadsAsCustomer Lead[]          @relation("CustomerLeads")
  reviews         Review[]        @relation("CustomerReviews")
  savedBusinesses SavedBusiness[]
  sentMessages    Message[]       @relation("SentMessages")
  otps            OtpCode[]
  serviceRequests ServiceRequest[]

  @@index([phone])
  @@index([role])
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String?
  phone     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([phone])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryTree")
  businesses      Business[]
  services        Service[]
  subCategories   SubCategory[]
  serviceRequests ServiceRequest[]
  questions       CategoryQuestion[]

  @@index([slug])
}

// Sub-categories belong to one parent Category.
// A business selects sub-categories from its own category only.
model SubCategory {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  slug       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category              Category              @relation(fields: [categoryId], references: [id])
  businessSubCategories BusinessSubCategory[]
  serviceRequests       ServiceRequest[]
  questions             CategoryQuestion[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

// Defines the dynamic per-category (or per-subcategory) question schema
// used to build the customer-facing ServiceRequest form.
// subCategoryId = null means the question applies to the whole category.
model CategoryQuestion {
  id            String       @id @default(cuid())
  categoryId    String
  subCategoryId String?
  key           String       // JSON key used in ServiceRequest.answers
  label         String
  type          QuestionType
  options       Json?        // choices for SELECT / MULTISELECT
  isRequired    Boolean      @default(false)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category    Category     @relation(fields: [categoryId], references: [id])
  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id])

  @@index([categoryId, subCategoryId])
}

// A marketplace request submitted by a customer, independent of any
// specific business. Matching produces one Lead per eligible business.
model ServiceRequest {
  id            String               @id @default(cuid())
  customerId    String
  categoryId    String
  subCategoryId String
  message       String
  jobAddress    String?
  jobDate       DateTime?
  budget        Int?
  answers       Json?
  status        ServiceRequestStatus @default(OPEN)
  expiresAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  customer    User        @relation(fields: [customerId], references: [id])
  category    Category    @relation(fields: [categoryId], references: [id])
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id])
  leads       Lead[]

  @@index([customerId])
  @@index([categoryId, subCategoryId])
  @@index([status])
}

model Business {
  id          String         @id @default(cuid())
  userId      String         @unique
  name        String
  slug        String         @unique
  description String?
  categoryId  String
  status      BusinessStatus @default(PENDING)
  isVerified  Boolean        @default(false)
  verifiedAt  DateTime?

  address         String?
  suburb          String?
  city            String  @default("Johannesburg")
  province        String  @default("Gauteng")
  lat             Float?
  lng             Float?

  phone           String?
  whatsapp        String?
  email           String?
  website         String?

  // logoUrl: primary logo, set via PATCH /businesses/:id { logoUrl }
  // coverUrl + photos: legacy fields — kept for backwards compatibility.
  // New gallery functionality uses BusinessGallery instead.
  logoUrl         String?
  coverUrl        String?
  photos          String[]

  priceMin        Int?
  priceMax        Int?
  operatingHours  Json?
  yearsInBusiness Int?

  // System-managed — never writable by clients
  ratingAvg       Float @default(0)
  reviewCount     Int   @default(0)
  leadCount       Int   @default(0)
  viewCount       Int   @default(0)
  stripeCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                  @relation(fields: [userId], references: [id])
  category              Category              @relation(fields: [categoryId], references: [id])
  services              Service[]
  leads                 Lead[]                @relation("BusinessLeads")
  reviews               Review[]              @relation("BusinessReviews")
  ads                   Ad[]
  subscription          Subscription?
  savedBy               SavedBusiness[]
  verification          BusinessVerification?
  messages              Message[]
  subCategories         BusinessSubCategory[]
  gallery               BusinessGallery[]
  wallet                BusinessWallet?
  creditPurchases       CreditPurchase[]

  @@index([slug])
  @@index([categoryId])
  @@index([city])
  @@index([lat, lng])
  @@index([status, isVerified])
  @@index([ratingAvg])
}

// Many-to-many: Business <-> SubCategory
model BusinessSubCategory {
  businessId    String
  subCategoryId String

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@id([businessId, subCategoryId])
  @@index([businessId])
}

// Project gallery — max 12 images per business, ordered by sortOrder
model BusinessGallery {
  id         String   @id @default(cuid())
  businessId String
  imageUrl   String
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sortOrder])
}

model BusinessVerification {
  id         String    @id @default(cuid())
  businessId String    @unique
  idDocUrl   String
  bizDocUrl  String?
  selfieUrl  String?
  status     String    @default("PENDING")
  adminNotes String?
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  categoryId  String?
  title       String
  description String?
  priceMin    Int?
  priceMax    Int?
  duration    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  leads    Lead[]

  @@index([businessId])
}

model Lead {
  id           String     @id @default(cuid())
  customerId   String
  businessId   String
  serviceId    String?
  status       LeadStatus @default(NEW)
  message      String
  voiceNoteUrl String?
  jobAddress   String?
  jobDate      DateTime?
  budget       Int?

  // --- Marketplace fields (all nullable/defaulted for backward compatibility
  // with existing direct-to-business leads, where serviceRequestId is null) ---
  serviceRequestId  String?           // null = legacy direct-to-business lead
  creditCost        Int?              // credit price snapshot at match time; null for legacy leads
  isUnlocked        Boolean  @default(true)  // legacy leads are already "unlocked" by definition
  unlockedAt        DateTime?
  unlockTransactionId String?  @unique       // pointer to the CreditTransaction that unlocked this lead
  expiresAt         DateTime?         // staleness window for an unpurchased marketplace opportunity

  viewedAt    DateTime?
  respondedAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer       User            @relation("CustomerLeads", fields: [customerId], references: [id])
  business       Business        @relation("BusinessLeads", fields: [businessId], references: [id])
  service        Service?        @relation(fields: [serviceId], references: [id])
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  unlockTransaction CreditTransaction? @relation("LeadUnlockTransaction", fields: [unlockTransactionId], references: [id])
  creditTransactions CreditTransaction[] @relation("LeadCreditTransactions")
  quotes   Quote[]
  messages Message[]

  @@unique([serviceRequestId, businessId])
  @@index([businessId, status])
  @@index([customerId])
  @@index([createdAt])
  @@index([serviceRequestId])
  @@index([isUnlocked])
}

model Quote {
  id          String      @id @default(cuid())
  leadId      String
  amount      Int
  description String
  lineItems   Json?
  validUntil  DateTime
  status      QuoteStatus @default(PENDING)
  acceptedAt  DateTime?
  createdAt   DateTime    @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
}

model Review {
  id         String    @id @default(cuid())
  customerId String
  businessId String
  leadId     String?
  rating     Int
  comment    String?
  isVerified Boolean   @default(false)
  reply      String?
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())

  customer User     @relation("CustomerReviews", fields: [customerId], references: [id])
  business Business @relation("BusinessReviews", fields: [businessId], references: [id])

  @@index([businessId])
  @@index([customerId])
}

model SavedBusiness {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@unique([userId, businessId])
}

model Message {
  id         String    @id @default(cuid())
  leadId     String
  senderId   String
  businessId String
  content    String?
  voiceUrl   String?
  type       String    @default("TEXT")
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  lead     Lead     @relation(fields: [leadId], references: [id])
  sender   User     @relation("SentMessages", fields: [senderId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@index([leadId])
}

model Subscription {
  id                 String             @id @default(cuid())
  businessId         String             @unique
  plan               SubscriptionPlan   @default(STARTER)
  status             SubscriptionStatus @default(TRIALING)
  stripeSubId        String?            @unique
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

model Ad {
  id             String   @id @default(cuid())
  businessId     String
  status         AdStatus @default(ACTIVE)
  boostLevel     Int      @default(1)
  budgetDaily    Int
  budgetMonthly  Int
  spentToday     Int      @default(0)
  spentThisMonth Int      @default(0)
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  lastResetAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([status])
}

model Payment {
  id          String   @id @default(cuid())
  businessId  String
  amount      Int
  type        String
  stripeId    String?
  status      String   @default("pending")
  description String?
  createdAt   DateTime @default(now())

  creditPurchase CreditPurchase?

  @@index([businessId])
}

// One wallet per business. `balance` is a cached/derived value kept in sync
// with CreditTransaction inside the same DB transaction as every ledger
// write — CreditTransaction remains the authoritative audit trail; this
// balance plus (isUnlocked/unlockedAt/unlockTransactionId on Lead) is the
// authoritative *current state*.
model BusinessWallet {
  id         String   @id @default(cuid())
  businessId String   @unique
  balance    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business            @relation(fields: [businessId], references: [id])
  transactions CreditTransaction[]
}

// Append-only ledger. Rows are never updated or deleted after creation.
model CreditTransaction {
  id                 String                @id @default(cuid())
  walletId           String
  amount             Int                   // signed: positive = credit, negative = debit
  balanceAfter       Int                   // wallet balance snapshot immediately after this entry
  type               CreditTransactionType
  reason             String?               // required in practice for REFUND / ADMIN_ADJUSTMENT
  relatedLeadId      String?
  relatedPurchaseId  String?
  performedByUserId  String?               // admin/system actor; null = automated
  idempotencyKey     String?               @unique
  createdAt          DateTime              @default(now())

  wallet          BusinessWallet  @relation(fields: [walletId], references: [id])
  lead            Lead?           @relation("LeadCreditTransactions", fields: [relatedLeadId], references: [id])
  purchase        CreditPurchase? @relation(fields: [relatedPurchaseId], references: [id])
  unlockedLead    Lead?           @relation("LeadUnlockTransaction")

  @@index([walletId, createdAt])
  @@index([relatedLeadId])
  @@index([relatedPurchaseId])
}

// "Money in" record for a business buying a credit pack. Kept separate from
// the generic Payment model (credit purchases have purchase-specific fields
// like `credits` and a unique Stripe PaymentIntent id), but optionally
// linked to a Payment row so future admin revenue reporting can aggregate
// credit purchases alongside subscriptions/ads from one table.
model CreditPurchase {
  id                    String               @id @default(cuid())
  businessId            String
  credits               Int
  amountCents           Int
  currency              String               @default("ZAR")
  status                CreditPurchaseStatus @default(PENDING)
  stripePaymentIntentId String?              @unique
  paymentId             String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  business     Business            @relation(fields: [businessId], references: [id])
  payment      Payment?            @relation(fields: [paymentId], references: [id])
  transactions CreditTransaction[]

  @@index([businessId])
}
