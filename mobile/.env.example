# Backend API the app talks to. Required — the app throws on startup if unset.
# Either the server origin or the full API root works; /api/v1 is appended if missing.
# On a physical device use your computer's LAN IP (not localhost); include the backend port.
# Expo inlines EXPO_PUBLIC_* at bundle time: restart with `npx expo start --clear` after changing.
# For EAS builds (.env is gitignored), set EXPO_PUBLIC_API_URL in the EAS environment for each profile.
EXPO_PUBLIC_API_URL=http://192.168.0.126:3000/api/v1
EXPO_PUBLIC_GOOGLE_MAPS_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
